DATABASE_URL=postgresql+psycopg2://postgres:your_db_password@localhost:5432/medconnect
FRONTEND_URL=http://localhost:5173

# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440

# Gmail SMTP with an app password. Leave SMTP_USER empty to print OTP codes in the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Turns on the one-click "Explore the patient demo" login (needs seed.py data)
DEMO_MODE=true

# A separate database for pytest, so the tests never touch the demo data
TEST_DATABASE_URL=postgresql+psycopg2://postgres:your_db_password@localhost:5432/medconnect_test
